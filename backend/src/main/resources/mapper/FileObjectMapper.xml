<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.campus.studyroom.file.mapper.FileObjectMapper">

  <resultMap id="fileObjectMap" type="edu.campus.studyroom.file.domain.FileObject">
    <id property="id" column="id"/>
    <result property="ownerId" column="owner_id"/>
    <result property="storageKey" column="storage_key"/>
    <result property="originalName" column="original_name"/>
    <result property="mimeType" column="mime_type"/>
    <result property="sizeBytes" column="size_bytes"/>
    <result property="sha256" column="sha256"/>
    <result property="state" column="state"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <sql id="fileColumns">
    id, owner_id, storage_key, original_name, mime_type, size_bytes, sha256, state, created_at
  </sql>

  <select id="selectById" resultMap="fileObjectMap">
    SELECT <include refid="fileColumns"/> FROM file_object WHERE id = #{id}
  </select>

  <select id="selectByStorageKey" resultMap="fileObjectMap">
    SELECT <include refid="fileColumns"/> FROM file_object WHERE storage_key = #{storageKey}
  </select>

  <insert id="insert" parameterType="edu.campus.studyroom.file.domain.FileObject"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO file_object (owner_id, storage_key, original_name, mime_type, size_bytes, sha256,
                             state, created_at)
    VALUES (#{ownerId}, #{storageKey}, #{originalName}, #{mimeType}, #{sizeBytes}, #{sha256},
            #{state}, #{createdAt})
  </insert>

  <!-- 条件状态变更：affectedRows 必须为 1 -->
  <update id="updateState">
    UPDATE file_object
    SET state = #{state}
    WHERE id = #{id} AND state = #{expectedState}
  </update>

  <!-- 24h 未绑定的 TEMP 文件；单批限量，调度器可重复调用 -->
  <select id="selectExpiredTemp" resultMap="fileObjectMap">
    SELECT <include refid="fileColumns"/> FROM file_object
    WHERE state = 'TEMP' AND created_at &lt; #{before}
    ORDER BY id
    LIMIT 500
  </select>

  <delete id="deleteById">
    DELETE FROM file_object WHERE id = #{id}
  </delete>
  <delete id="deleteByOwner">
    DELETE FROM file_object WHERE owner_id = #{ownerId}
  </delete>
</mapper>
