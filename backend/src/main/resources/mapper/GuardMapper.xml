<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.campus.studyroom.rule.mapper.GuardMapper">

  <resultMap id="businessGuardMap" type="edu.campus.studyroom.rule.domain.BusinessGuard">
    <id property="id" column="id"/>
    <result property="activeRuleId" column="active_rule_id"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <!-- 核心写事务串行化协调行：必须在已开启的事务内调用 -->
  <select id="lockGuard" resultMap="businessGuardMap">
    SELECT id, active_rule_id, updated_at
    FROM business_guard
    WHERE id = 1
    FOR UPDATE
  </select>

  <select id="selectGuard" resultMap="businessGuardMap">
    SELECT id, active_rule_id, updated_at
    FROM business_guard
    WHERE id = 1
  </select>

  <update id="updateActiveRule" parameterType="edu.campus.studyroom.rule.domain.BusinessGuard">
    UPDATE business_guard
    SET active_rule_id = #{activeRuleId}, updated_at = #{updatedAt}
    WHERE id = 1
  </update>

</mapper>
