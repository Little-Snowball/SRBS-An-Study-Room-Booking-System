    "axios": "1.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.0"
  }
}
