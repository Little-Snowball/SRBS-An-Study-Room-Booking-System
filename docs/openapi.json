  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "ApiResponseLoginResponse": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/LoginResponse" }, "traceId": { "type": "string" }, "serverTime": { "type": "string" } } },
      "ApiResponseUserProfile": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/UserProfile" }, "traceId": { "type": "string" }, "serverTime": { "type": "string" } } },
      "ErrorEnvelope": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "data": { "type": "null" }, "traceId": { "type": "string" }, "serverTime": { "type": "string" }, "errorDetails": {} } },
      "LoginRequest": { "type": "object", "required": ["account", "password"], "properties": { "account": { "type": "string" }, "password": { "type": "string" } } },
      "ChangePasswordRequest": { "type": "object", "required": ["oldPassword", "newPassword"], "properties": { "oldPassword": { "type": "string" }, "newPassword": { "type": "string", "minLength": 12, "maxLength": 64 } } },
      "LoginResponse": { "type": "object", "properties": { "accessToken": { "type": "string" }, "expiresAt": { "type": "string" }, "user": { "$ref": "#/components/schemas/UserProfile" }, "mustChangePassword": { "type": "boolean" } } },
      "UserProfile": { "type": "object", "properties": { "id": { "type": "string" }, "account": { "type": "string" }, "name": { "type": "string" }, "college": { "type": "string" }, "role": { "enum": ["STUDENT", "ADMIN"] }, "creditScore": { "type": "integer" }, "creditRestricted": { "type": "boolean" }, "blocked": { "type": "boolean" } } },
      "ReservationStatus": { "type": "string", "enum": ["RESERVED", "IN_USE", "LEFT_TEMP", "COMPLETED", "CANCELLED", "VIOLATED"] },
      "CreateReservationRequest": { "type": "object", "required": ["seatId", "startAt", "endAt"], "properties": { "seatId": { "type": "string" }, "startAt": { "type": "string", "example": "2026-10-15T09:00:00+08:00" }, "endAt": { "type": "string", "example": "2026-10-15T11:30:00+08:00" } } },
      "CheckInRequest": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } } },
      "SubmitAppealRequest": { "type": "object", "required": ["violationId", "reason"], "properties": { "violationId": { "type": "string" }, "reason": { "type": "string", "minLength": 10, "maxLength": 1000 }, "fileIds": { "type": "array", "items": { "type": "string" }, "maxItems": 3 } } },
      "CreateRoomRequest": { "type": "object", "required": ["code", "name", "campus", "building", "openTime", "closeTime", "rows", "cols", "checkinCode"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "campus": { "type": "string" }, "building": { "type": "string" }, "openTime": { "type": "string", "example": "07:00" }, "closeTime": { "type": "string", "example": "22:30" }, "rows": { "type": "integer", "maximum": 100 }, "cols": { "type": "integer", "maximum": 100 }, "checkinCode": { "type": "string", "pattern": "^[0-9]{6}$" } } }
    }
  }
